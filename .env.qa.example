# Copy to a PRIVATE .env.qa; never commit secrets. Product/domain not confirmed yet.
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=qa.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://qa.example.com
DJANGO_HTTPS_ENABLED=true
# Persistent directory OUTSIDE the checkout, different from production HACCP_DATA_DIR.
HACCP_QA_DATA_DIR=/srv/biodot/qa-data
# Enable only for the explicit first seed, then turn off and restart.
HACCP_QA_SEED_ENABLED=false
HACCP_SITE_ADDRESS=qa.example.com
HACCP_BIND=0.0.0.0
HACCP_UPSTREAM=127.0.0.1:8002
HACCP_STATIC_DIR=/srv/biodot/qa-data/static
# QA gateway credentials; generate hash with caddy hash-password, never use SSH credentials.
HACCP_QA_AUTH_USER=qa-tester
HACCP_QA_AUTH_HASH=replace-with-caddy-password-hash
