# scripts/project.py init replaces this placeholder with a random local secret.
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Relative paths are resolved from the repository root on every OS.
HACCP_DATA_DIR=data
# 개발 콘솔(처리 단계 추적·DB 스냅샷 API). 개발 설정에서만 동작하며 기본값 true. 운영에서는 항상 꺼짐.
# HACCP_DEV_CONSOLE=true
# Local production smoke tests use HTTP on loopback only.
# For actual HTTPS deployment use .env.production.example.
DJANGO_HTTPS_ENABLED=false
# 문서함·결재함 메뉴 자리: dev(개발 검증 섹션, 기본) 또는 haccp(HACCP 관리 섹션 맨 위).
# HACCP_DOC_MENU=dev
# 역할(HACCP팀장·양식 담당자·결재 칸)은 DB 문서 권한(P16). 기존 roles.json은 manage.py import_roles로 옮깁니다.
