# Copy to .env.production, set a new random secret and actual company hostname.
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=haccp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://haccp.example.com
DJANGO_HTTPS_ENABLED=true
# Use forward slashes in Windows paths. Keep DB/uploads outside the code directory.
HACCP_DATA_DIR=C:/HACCPData
